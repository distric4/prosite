<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{% if title %}{{ title }} — {{ site.brand }}{% else %}{{ site.brand }} · {{ site.name }}{% endif %}</title>
    <meta name="description" content="{{ description or (site.brand + '. ' + site.tagline + '. ' + site.city + '.') }}" />
    <link rel="canonical" href="{{ site.url }}{{ page.url }}" />

    <!-- OpenGraph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="{% if title %}{{ title }} — {{ site.brand }}{% else %}{{ site.brand }}{% endif %}" />
    <meta property="og:description" content="{{ description or site.tagline }}" />
    <meta property="og:url" content="{{ site.url }}{{ page.url }}" />
    <meta property="og:locale" content="ru_RU" />

    <!-- Шрифты Google: Manrope (текст) + Syne (заголовки) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700&family=Syne:wght@600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Стили сайта -->
    <link rel="stylesheet" href="/styles/tokens.css" />
    <link rel="stylesheet" href="/styles/base.css" />
    <link rel="stylesheet" href="/styles/components.css" />
    <link rel="stylesheet" href="/styles/sections.css" />
    <link rel="stylesheet" href="/styles/animations.css" />
    {% if premium %}
    <!-- Премиум-направление (Fraunces + Inter Tight, движок анимаций) -->
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,340..680;1,9..144,340..600&family=Inter+Tight:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/styles/premium.css" />
    {% endif %}
    {% if homeV2 %}
    <!-- Новая главная (v2): Onest + своя дизайн-система -->
    <link
      href="https://fonts.googleapis.com/css2?family=Onest:wght@400;500;600;700;800&family=Caveat:wght@600&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/styles/home.css" />
    {% endif %}

    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%2300af92'/%3E%3C/svg%3E"
    />
  </head>
  <body class="{% if premium %}premium{% endif %}{% if homeV2 %} v2{% endif %}">
    {% if not bareChrome %}{% include "partials/header.njk" %}{% endif %}

    <main id="top">{{ content | safe }}</main>

    {% if not bareChrome %}{% include "partials/footer.njk" %}{% endif %}

    <script src="/js/main.js" defer></script>
    {% if premium %}
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js" defer></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js" defer></script>
    <script src="https://cdn.jsdelivr.net/npm/@studio-freight/lenis@1.0.42/dist/lenis.min.js" defer></script>
    <script src="/js/premium.js" defer></script>
    {% endif %}
    {% if homeV2 %}
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js" defer></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js" defer></script>
    <script src="/js/home.js" defer></script>
    {% endif %}
  </body>
</html>
