<footer class="site-footer">
  <div class="container">
    <div class="footer__brandrow">
      <span class="brand__name">{{ site.brand }}</span>
    </div>

    <div class="footer__cols">
      <div class="footer__col">
        <h4>Разделы</h4>
        <a href="/">Главная</a>
        <a href="/#metod">Подход</a>
        <a href="/#works">Работы</a>
        <a href="/#tarifs">Тарифы</a>
        <a href="/#follow">Ведение</a>
        <a href="/#audit">Аудит</a>
      </div>
      <div class="footer__col">
        <h4>Дополнительно</h4>
        <a href="/#metod">Кто я?</a>
        <a href="{{ site.vc }}" target="_blank" rel="noopener">Блог</a>
        <a href="/works/">Кейсы</a>
        <a href="/#contacts">Контакты</a>
      </div>
      <div class="footer__social">
        <div class="footer__soc">
          <h4>Статьи про сайты</h4>
          <a href="{{ site.vc }}" target="_blank" rel="noopener">На VC.RU</a>
        </div>
        <div class="footer__soc">
          <h4>Телеграм</h4>
          <a href="{{ site.telegram }}" target="_blank" rel="noopener">{{ site.telegramHandle }}</a>
        </div>
        <div class="footer__soc">
          <h4>{{ site.maxLabel }}</h4>
          <a href="{{ site.max }}" target="_blank" rel="noopener">Написать в {{ site.maxLabel }}</a>
        </div>
        <div class="footer__soc">
          <h4>ТГ-канал</h4>
          <a href="{{ site.channel }}" target="_blank" rel="noopener">{{ site.channelName }}</a>
        </div>
      </div>
    </div>

    <div class="footer__bottom">
      <span>© {% year %} Dianov Aleksey</span>
      <a href="/privacy/">Политика конфиденциальности</a>
    </div>
  </div>
</footer>
